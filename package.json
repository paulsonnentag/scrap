{
  "name": "page-extractor",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that extracts user-defined data from web pages with Jev and stores it in Automerge.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@automerge/automerge-repo": "2.5.6",
    "@automerge/automerge-repo-storage-indexeddb": "2.5.6",
    "zod": "^4.6.5"
  }
}
